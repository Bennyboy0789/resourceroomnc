# Copy to .env.local and fill in. Never commit real keys.

# Stripe secret key. Test keys start sk_test_, live keys sk_live_.
# Without this the site still builds and every page renders — the enrollment
# sections simply do not appear and program pages fall back to the
# consultation call to action.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the Stripe webhook at /api/stripe/webhook, which is what
# sends the order email to the office and the receipt to the customer.
# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Each endpoint has its own secret, so test and live differ. Without it the
# route rejects every request: an unverified webhook would let anyone who
# guesses the URL forge an order and trigger mail.
STRIPE_WEBHOOK_SECRET=whsec_...

# Absolute origin used for Stripe's success and cancel redirects.
#
# SET THIS IN PRODUCTION. Without it a paying customer can be returned to the
# per-deployment *.vercel.app hostname, which is behind Vercel Authentication —
# they get a Vercel login page instead of their confirmation. The code now
# falls back to VERCEL_PROJECT_PRODUCTION_URL before the deployment hostname,
# but this variable is what pins the exact origin, www included.
NEXT_PUBLIC_SITE_URL=https://www.resourceroom.com

# --- SMTP2Go: delivers the consultation and careers forms -------------------
# API key from SMTP2Go > Settings > API Keys. Needs the "Email: send" scope.
# Without it both forms show an error telling the visitor to call instead, and
# the attempt is logged — submissions are never silently dropped.
SMTP2GO_API_KEY=api-...

# Verified sender. The domain must be verified in SMTP2Go or delivery fails.
# Do not send as the visitor's address — that breaks SPF/DKIM. The visitor is
# put in Reply-To instead, so replying from the inbox reaches them.
SMTP2GO_SENDER=website@resourceroom.com

# Where form submissions land. Comma-separated for more than one recipient.
SMTP2GO_TO=Learn@ResourceRoomNC.com
